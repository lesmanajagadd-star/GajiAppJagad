        android:layout_marginTop="20dp"
        android:layout_marginBottom="50dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sallary Counting Versi 1.0"
        android:textSize="18sp"
